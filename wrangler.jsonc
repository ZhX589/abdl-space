/**
 * Workers config for ABDL Space API (api.abdl-space.top)
 * Hono 后端独立部署到 Cloudflare Workers
 *
 * 本地开发: npm run dev
 * 生产部署: npm run deploy
 * 设置密钥: npx wrangler secret put JWT_SECRET --name abdl-space-api
 * 私有小说使用独立最小权限密钥（仅声明名称，值必须通过 Wrangler Secret 设置）:
 * npx wrangler secret put NOVEL_COS_SECRET_ID --name abdl-space-api
 * npx wrangler secret put NOVEL_COS_SECRET_KEY --name abdl-space-api
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "abdl-space-api",
	"main": "src/api-worker.ts",
	"compatibility_date": "2026-05-07",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"COS_BUCKET": "abdl-1339643562",
		"COS_REGION": "ap-shanghai",
		"COS_PUBLIC_ORIGIN": "https://abdl-1339643562.cos.ap-shanghai.myqcloud.com",
		"NOVEL_PRIVATE_COS_BUCKET": "abdl-private-books-1339643562",
		"NOVEL_PRIVATE_COS_REGION": "ap-shanghai"
	},
	"d1_databases": [
		{
			"binding": "abdl_space_db",
			"database_name": "abdl-space-db",
			"database_id": "159f81ba-ea32-4667-a3ce-d72cb1659d93"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "USER_PRESENCE",
				"class_name": "UserPresence"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-user-presence",
			"new_sqlite_classes": ["UserPresence"]
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "MESSAGE_OUTBOX_QUEUE",
				"queue": "message-outbox"
			}
		],
		"consumers": [
			{
				"queue": "message-outbox",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "message-outbox-dlq"
			}
		]
	},
	"triggers": {
		"crons": ["* * * * *"]
	}
}
